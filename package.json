{
  "name": "dsh-review-threads",
  "version": "0.1.0",
  "description": "Persistent GitHub-style review threads for DeepSeek Harness diffs, shared by users and AI.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "code-review",
    "diff",
    "review-thread"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "skills",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huandu/dsh-review-threads.git"
  },
  "bugs": {
    "url": "https://github.com/huandu/dsh-review-threads/issues"
  },
  "homepage": "https://github.com/huandu/dsh-review-threads",
  "engines": {
    "node": ">=22.18",
    "dsh": ">=0.2.1-rc.1 <0.2.2-0"
  },
  "scripts": {
    "build": "tsdown",
    "check:docs": "node scripts/check-docs.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "pack:check": "node scripts/verify-pack.mjs",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:docs && pnpm pack:check && pnpm test:e2e"
  },
  "dsh": {
    "manifestVersion": 1,
    "adapter": {
      "cliVersion": "0.2.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": ">=0.2.1-rc.1 <0.2.2-0",
    "@deepseek-ai/dsh-client-connection": ">=0.2.1-rc.1 <0.2.2-0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.1-rc.1 <0.2.2-0",
    "@deepseek-ai/dsh-commands": ">=0.2.1-rc.1 <0.2.2-0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.1 <0.2.2-0",
    "@deepseek-ai/dsh-session": ">=0.2.1-rc.1 <0.2.2-0",
    "@deepseek-ai/dsh-skill": ">=0.2.1-rc.1 <0.2.2-0",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.1-rc.1 <0.2.2-0",
    "@deepseek-ai/dsh-subprocess": ">=0.2.1-rc.1 <0.2.2-0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.1-rc.1 <0.2.2-0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.1 <0.2.2-0",
    "@deepseek-ai/dsh-util-workspace-path": ">=0.2.1-rc.1 <0.2.2-0",
    "@deepseek-ai/dsh-workspace-changes": ">=0.2.1-rc.1 <0.2.2-0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.1-rc.2",
    "@deepseek-ai/dsh-workspace-changes": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.0",
    "@types/react": "~18.3.0",
    "@types/react-dom": "~18.3.0",
    "eslint": "^10.0.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.7.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@11.14.0"
}
